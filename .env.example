# Primary engine: OpenRouter free models (used when set)
OPENROUTER_API_KEY=

# Fallback engine: Google Antigravity SDK (used when OPENROUTER_API_KEY is unset)
GEMINI_API_KEY=

# Optional override for the Haraj public client-side key (see config.py)
HARAJ_SERVER_KEY=

# OPT-IN, default OFF. Google News RSS is licensed for personal,
# non-commercial use only (https://www.google.com/intl/en_us/terms_google_news.html).
# This agent produces commercial product ideas — enabling this in a commercial
# pipeline is outside that license. Set to 1 only for personal experimentation.
GOOGLE_NEWS_RSS_ENABLED=
